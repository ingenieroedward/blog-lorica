# Base de datos PostgreSQL
DATABASE_URL="postgresql://user:password@host:5432/bajosinu"

# URL pública del sitio (sin slash final)
NEXT_PUBLIC_SITE_URL="https://bajosinu.top"

# Secreto para firmar JWT de sesión admin (mínimo 32 chars)
